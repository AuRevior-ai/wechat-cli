{
  "name": "@wechat-cli/license-update-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env staging",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e:local": "python scripts/run_local_e2e.py",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply wechat-cli-license-staging --local --env staging",
    "db:migrate:staging": "wrangler d1 migrations apply wechat-cli-license-staging --remote --env staging"
  },
  "dependencies": {
    "hono": ">=4.0.0 <5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": ">=4.20260101.0",
    "typescript": ">=5.5.0 <7",
    "vitest": ">=3.0.0 <5",
    "wrangler": ">=4.0.0 <5"
  }
}
